---
// Zoom toolbar for a diagram. Place inside an element with data-zoom="svg" or data-zoom="html".
import Icon from './Icon.astro';
---

<div class="zoom-controls" role="toolbar" aria-label="Zoom">
  <button type="button" data-zoom-out title="Zoom out (Ctrl + scroll)" aria-label="Zoom out"><Icon name="zoom-out" size={16} /></button>
  <span class="zoom-level" data-zoom-level aria-live="polite">100%</span>
  <button type="button" data-zoom-in title="Zoom in (Ctrl + scroll, or double-click)" aria-label="Zoom in"><Icon name="zoom-in" size={16} /></button>
  <button type="button" data-zoom-fit title="Fit to view" aria-label="Fit to view">Fit</button>
  <button type="button" data-zoom-full title="Full screen" aria-label="Full screen"><Icon name="screen-full" size={16} /></button>
  <span class="zoom-hint">Ctrl + scroll or pinch to zoom, drag to pan</span>
</div>

<style>
  .zoom-controls {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }
  .zoom-controls button {
    display: inline-grid;
    place-items: center;
    min-width: 32px;
    height: 32px;
    padding: 0 8px;
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    color: var(--navy);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    cursor: pointer;
  }
  .zoom-controls button:hover {
    background: var(--warm);
  }
  .zoom-level {
    min-width: 46px;
    text-align: center;
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }
  .zoom-hint {
    margin-left: 8px;
    font-size: 12px;
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .zoom-hint {
      display: none;
    }
  }
</style>
