---
// A link to any entity, with an icon for its kind. People link to their primary team.
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { atlas, href } from '../lib/atlas';
import { nameOf } from '../../../engine/lib/model.mjs';

interface Props {
  entity: any;
  logo?: boolean;
}
const { entity, logo = true } = Astro.props;
const url =
  entity.kind === 'team'
    ? href(`teams/${entity.id}/`)
    : entity.kind === 'platform'
      ? href(`platforms/${entity.id}/`)
      : entity.kind === 'product'
        ? href(`products/${entity.id}/`)
        : entity.kind === 'committee'
          ? href(`committees/${entity.id}/`)
        : entity.kind === 'person'
          ? href(`people/${entity.id}/`)
          : null;
const icon =
  entity.kind === 'committee'
    ? (atlas().vocab.committeeType[entity.type]?.icon ?? 'law')
    : entity.kind === 'persona'
      ? entity.icon
    : ({ team: 'people', person: 'person', 'business-unit': 'organization', organization: 'organization' }[entity.kind as string] ?? 'package');
const showLogo = logo && (entity.kind === 'platform' || entity.kind === 'product');
const Tag = url ? 'a' : 'span';
---

<Tag class="ref" href={url ?? undefined} title={entity.kind === 'persona' ? [entity.description, entity.size].filter(Boolean).join(' | ') : undefined}>
  {showLogo ? <Logo entity={entity} size={22} /> : <span class:list={['ref-icon', { committee: entity.kind === 'committee', external: entity.kind === 'persona' && entity.internal === false }]}><Icon name={icon} size={14} /></span>}
  <span class="ref-name">{nameOf(entity)}</span>
</Tag>

<style>
  .ref {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    font-weight: 600;
  }
  .ref-icon {
    display: inline-grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--surface-tint);
    color: var(--blue);
    flex: none;
  }
  .ref-icon.external {
    background: transparent;
    border: 1px dashed var(--muted);
  }
  .ref-icon.committee {
    border-radius: 4px;
    background: var(--gold);
    color: var(--on-gold);
  }
  .ref-name {
    overflow-wrap: anywhere;
  }
</style>
