---
// Filterable card grid of platforms or products.
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import EntityRef from './EntityRef.astro';
import StackChips from './StackChips.astro';
import { atlas, href } from '../lib/atlas';

interface Props {
  kind: 'platform' | 'product';
}
const { kind } = Astro.props;
const { model } = atlas();
const list = kind === 'platform' ? model.platforms : model.products;
const path = kind === 'platform' ? 'platforms' : 'products';
const categories = [...new Set(list.map((e: any) => (kind === 'platform' ? e.category : e.criticality)).filter(Boolean))].sort();
const types = kind === 'product' ? [...new Set(list.map((e: any) => e.type ?? 'product'))].sort() : [];
const techs = [...new Map(list.flatMap((e: any) => (e.stackItems ?? []).map((t: any) => [t.id, t.label]))).entries()].sort((a: any, b: any) => a[1].localeCompare(b[1]));
const ownerTeams = [...new Map(list.flatMap((e: any) => model.edgesTo(e, 'owner').map((x: any) => [x.from.id, x.from]))).values()].sort(
  (a: any, b: any) => a.name.localeCompare(b.name),
);
const usageCount = (e: any) =>
  kind === 'platform'
    ? new Set([...model.edgesTo(e, 'uses'), ...model.edgesTo(e, 'deployed-to')].map((x: any) => x.from.id)).size
    : new Set([...model.edgesFrom(e, 'uses'), ...model.edgesFrom(e, 'deployed-to')].map((x: any) => x.to.id)).size;
const hosts = (e: any) => (kind === 'platform' ? model.edgesTo(e, 'deployed-to').length : 0);
const deployedTo = (e: any) => (kind === 'product' ? model.edgesFrom(e, 'deployed-to').map((x: any) => x.to) : []);
---

<form class="toolbar panel" onsubmit="return false">
  <label class="field grow">
    <Icon name="search" size={16} />
    <input id="x-q" type="search" placeholder={`Search ${path}`} autocomplete="off" aria-label={`Search ${path}`} />
  </label>
  <label class="field">
    <span class="field-label">{kind === 'platform' ? 'Category' : 'Criticality'}</span>
    <select id="x-cat">
      <option value="">All</option>
      {categories.map((c: any) => <option value={c}>{c}</option>)}
    </select>
  </label>
  <label class="field">
    <span class="field-label">Owner</span>
    <select id="x-owner">
      <option value="">Any</option>
      {ownerTeams.map((t: any) => <option value={`${t.kind}:${t.id}`}>{t.name ?? t.displayName}</option>)}
    </select>
  </label>
  {
    types.length > 1 && (
      <label class="field">
        <span class="field-label">Type</span>
        <select id="x-type">
          <option value="">All</option>
          {types.map((t: any) => <option value={t}>{t.replace('-', ' ')}</option>)}
        </select>
      </label>
    )
  }
  {
    techs.length > 0 && (
      <label class="field">
        <span class="field-label">Built with</span>
        <select id="x-tech">
          <option value="">Any</option>
          {techs.map(([id, label]: any) => <option value={id}>{label}</option>)}
        </select>
      </label>
    )
  }
  <label class="check"><input id="x-shared" type="checkbox" /> Shared ownership</label>
  <label class="check"><input id="x-unowned" type="checkbox" /> Unowned</label>
  <p id="x-count" class="count muted" aria-live="polite"></p>
</form>

<ul class="cards">
  {
    list.map((e: any) => {
      const owners = model.edgesTo(e, 'owner');
      const supporting = model.edgesTo(e, 'supporting');
      return (
        <li
          class="card panel"
          data-cat={kind === 'platform' ? (e.category ?? '') : (e.criticality ?? '')}
          data-owners={owners.map((o: any) => `${o.from.kind}:${o.from.id}`).join(' ')}
          data-tech={(e.stackItems ?? []).map((t: any) => t.id).join(' ')}
          data-type={e.type ?? 'product'}
          data-text={[e.name, e.description, e.vendor, ...owners.map((o: any) => o.from.name ?? o.from.displayName)].join(' ').toLowerCase()}
        >
          <div class="card-head">
            <Logo entity={e} size={44} />
            <div>
              <a class="card-name" href={href(`${path}/${e.id}/`)}>
                {e.name}
              </a>
              <span class="muted small">
                {[e.category, kind === 'product' && e.type && e.type !== 'product' ? e.type.replace('-', ' ') : null, e.version && `v${e.version}`, e.vendor ?? (e.proprietary ? 'In-house' : null), e.criticality].filter(Boolean).join(' | ')}
              </span>
              {e.parentProduct && (
                <span class="muted small">
                  <Icon name="stack" size={12} /> Part of <a href={href(`${path}/${e.parentProduct.id}/`)}>{e.parentProduct.name}</a>
                </span>
              )}
            </div>
          </div>
          {e.description && <p class="desc">{e.description}</p>}
          <StackChips entity={e} size="sm" />
          <div class="owners">
            <span class="label">
              <Icon name="shield-check" size={12} /> {owners.length > 1 ? 'Shared ownership' : 'Owner'}
            </span>
            {owners.map((o: any) => (
              <EntityRef entity={o.from} />
            ))}
            {owners.length === 0 && e.inheritsOwnershipFrom && <span class="muted small">Through {e.inheritsOwnershipFrom.name}</span>}
            {owners.length === 0 && !e.inheritsOwnershipFrom && <span class="stamp">Unowned</span>}
          </div>
          {supporting.length > 0 && (
            <div class="owners">
              <span class="label">
                <Icon name="tools" size={12} /> Supporting
              </span>
              {supporting.map((o: any) => (
                <EntityRef entity={o.from} />
              ))}
            </div>
          )}
          {deployedTo(e).length > 0 && (
            <div class="owners">
              <span class="label">
                <Icon name="cloud" size={12} /> Deployed to
              </span>
              {deployedTo(e).map((p: any) => (
                <EntityRef entity={p} />
              ))}
            </div>
          )}
          <div class="foot muted small">
            <Icon name="plug" size={12} />{' '}
            {kind === 'platform'
              ? `Used by ${usageCount(e)} product${usageCount(e) === 1 ? '' : 's'}${hosts(e) ? `, hosts ${hosts(e)}` : ''}`
              : `Uses ${usageCount(e)} platform${usageCount(e) === 1 ? '' : 's'}`}
          </div>
        </li>
      );
    })
  }
</ul>

<script>
  const q = document.querySelector('#x-q') as HTMLInputElement;
  const cat = document.querySelector('#x-cat') as HTMLSelectElement;
  const owner = document.querySelector('#x-owner') as HTMLSelectElement;
  const shared = document.querySelector('#x-shared') as HTMLInputElement;
  const unowned = document.querySelector('#x-unowned') as HTMLInputElement;
  const tech = document.querySelector('#x-tech') as HTMLSelectElement | null;
  const ptype = document.querySelector('#x-type') as HTMLSelectElement | null;
  const count = document.querySelector('#x-count') as HTMLParagraphElement;
  const cards = [...document.querySelectorAll<HTMLElement>('.card')];
  const params = new URLSearchParams(location.search);
  q.value = params.get('q') ?? '';
  owner.value = params.get('owner') ?? '';
  function apply() {
    const term = q.value.trim().toLowerCase();
    let shown = 0;
    for (const c of cards) {
      const owners = (c.dataset.owners ?? '').split(' ').filter(Boolean);
      const ok =
        (!term || (c.dataset.text ?? '').includes(term)) &&
        (!cat.value || c.dataset.cat === cat.value) &&
        (!owner.value || owners.includes(owner.value)) &&
        (!shared.checked || owners.length > 1) &&
        (!unowned.checked || owners.length === 0) &&
        (!tech?.value || (c.dataset.tech ?? '').split(' ').includes(tech.value)) &&
        (!ptype?.value || c.dataset.type === ptype.value);
      c.hidden = !ok;
      if (ok) shown++;
    }
    count.textContent = `Showing ${shown} of ${cards.length}`;
  }
  [q, cat, owner, shared, unowned, tech, ptype].forEach((el) => el?.addEventListener('input', apply));
  if (ptype) ptype.value = params.get('type') ?? '';
  if (tech) tech.value = params.get('tech') ?? '';
  apply();
</script>

<style>
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 12px 16px;
    padding: 14px 16px;
    margin-bottom: 24px;
    background: var(--warm);
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 3px;
    font-size: 13px;
    color: var(--muted);
  }
  .field-label {
    font-weight: 600;
  }
  .field.grow {
    flex: 1 1 240px;
    flex-direction: row;
    align-items: center;
    gap: 8px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0 10px;
  }
  .field.grow input {
    border: 0;
    flex: 1;
    min-width: 0;
    padding: 9px 0;
    font: inherit;
    font-size: 14px;
    outline: none;
    background: transparent;
    color: var(--text);
  }
  .field select {
    font: inherit;
    font-size: 14px;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 7px 10px;
    min-width: 150px;
  }
  .check {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    padding-bottom: 8px;
  }
  .count {
    margin: 0;
    font-size: 13px;
    flex-basis: 100%;
  }
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 16px;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px 18px;
    border-top: 3px solid var(--navy);
  }
  .card[hidden] {
    display: none;
  }
  .card-head {
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .card-head > div {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .card-name {
    font-weight: 700;
    font-size: 1.02rem;
    color: var(--navy);
  }
  .small {
    font-size: 12px;
  }
  .desc {
    margin: 0;
    font-size: 14px;
    color: var(--muted);
  }
  .owners {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    font-size: 14px;
  }
  .label {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    flex-basis: 100%;
  }
  .stamp {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--danger);
    border: 2px solid var(--danger);
    border-radius: 3px;
    padding: 0 6px;
  }
  .foot {
    margin-top: auto;
    border-top: 1px solid var(--border);
    padding-top: 8px;
    display: flex;
    align-items: center;
    gap: 6px;
    text-transform: none;
  }
</style>
