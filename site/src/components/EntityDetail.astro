---
// Detail page body for a platform or product.
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import EntityRef from './EntityRef.astro';
import RelLine from './RelLine.astro';
import RelationshipMap from './RelationshipMap.astro';
import ContextDiagram from './ContextDiagram.astro';
import StackChips from './StackChips.astro';
import { atlas, href } from '../lib/atlas';

interface Props {
  entity: any;
}
const { entity } = Astro.props;
const { model, vocab } = atlas();
const isPlatform = entity.kind === 'platform';
const section = isPlatform ? { label: 'Platforms', to: 'platforms/' } : { label: 'Products', to: 'products/' };

const deployments = isPlatform ? model.edgesTo(entity, 'deployed-to') : model.edgesFrom(entity, 'deployed-to');
const list = (v: any) => [].concat(v ?? []).join(', ');
const allEnvs = [...new Set(deployments.flatMap((d: any) => [].concat(d.environments ?? [])))];

const ancestors: any[] = [];
for (let a = entity.parentProduct; a; a = a.parentProduct) ancestors.unshift(a);
const children = entity.children ?? [];
const typeLabel = (e: any) => {
  const t = (e.type ?? 'product').replace('-', ' ');
  return t.charAt(0).toUpperCase() + t.slice(1);
};

const facts = [
  ['Category', entity.category],
  ['Type', !isPlatform ? (entity.type ?? 'product').replace('-', ' ') : null],
  ['Part of', entity.parentProduct ? entity.parentProduct.name : null],
  ['Version', entity.version],
  ['Vendor', entity.vendor],
  ['Hosting', entity.hosting],
  ['Criticality', entity.criticality],
  ['Lifecycle', entity.lifecycle ?? 'active'],
  ['Environments', !isPlatform && allEnvs.length ? allEnvs.join(', ') : null],
  ['Built in-house', entity.proprietary ? 'Yes (proprietary)' : null],
].filter(([, v]) => v);

const accountability = vocab.relTypes
  .filter((t: any) => ['accountability', 'audience', 'governance'].includes(t.category))
  .flatMap((t: any) => model.edgesTo(entity, t.id));


const usage = isPlatform ? model.edgesTo(entity, 'uses') : model.edgesFrom(entity, 'uses');
const ownersOf = (e: any) => model.edgesTo(e, 'owner').map((x: any) => x.from);
const links = entity.links ? Object.entries(entity.links) : [];
---

<nav class="crumbs" aria-label="Breadcrumb">
  <a href={href(section.to)}>{section.label}</a>
  {
    ancestors.map((a: any) => (
      <>
        <Icon name="chevron-right" size={12} />
        <a href={href(`products/${a.id}/`)}>{a.name}</a>
      </>
    ))
  }
  <Icon name="chevron-right" size={12} />
  <span aria-current="page">{entity.name}</span>
</nav>

<header class="head panel">
  <Logo entity={entity} size={64} />
  <div class="head-text">
    <span class="eyebrow">{isPlatform ? 'Platform' : entity.type === 'solution' ? 'Solution' : 'Product'}</span>
    <h1>{entity.name}</h1>
    {entity.description && <p class="muted">{entity.description}</p>}
    {entity.parentProduct && (
      <p class="part-of">
        <Icon name="stack" size={14} /> Part of <a href={href(`products/${entity.parentProduct.id}/`)}>{entity.parentProduct.name}</a>
      </p>
    )}
    {entity.stackItems?.length > 0 && (
      <div class="built-with">
        <span class="eyebrow">Built with</span>
        <StackChips entity={entity} />
      </div>
    )}
  </div>
</header>

{
  children.length > 0 && (
    <section class="panel block contains">
      <h2 class="eyebrow">
        <Icon name="stack" size={14} /> Contains <span class="n">{children.length}</span>
      </h2>
      <ul class="kids">
        {children.map((c: any) => (
          <li class="kid">
            <Logo entity={c} size={36} />
            <div class="kid-text">
              <a href={href(`products/${c.id}/`)} class="kid-name">
                {c.name}
              </a>
              <span class="muted small">
                {[typeLabel(c), c.version && `v${c.version}`, c.criticality, c.lifecycle && c.lifecycle !== 'active' ? c.lifecycle : null].filter(Boolean).join(' | ')}
              </span>
              <StackChips entity={c} size="sm" />
              {c.children?.length > 0 && <span class="small muted">Contains {c.children.length} more</span>}
            </div>
          </li>
        ))}
      </ul>
    </section>
  )
}

<h2 class="section-title">Context diagram</h2>
<p class="muted intro">Who owns, supports, governs and uses {entity.name}.</p>
<ContextDiagram entity={entity} />
<div class="spacer"></div>

<h2 class="section-title">Relationship map</h2>
<RelationshipMap entity={entity} />

<div class="cols">
  <section class="panel block">
    <h2 class="eyebrow">Accountability</h2>
    {entity.inheritsOwnershipFrom && (
      <p class="inherit">
        <Icon name="shield-check" size={14} /> No owner of its own: owned through <a href={href(`products/${entity.inheritsOwnershipFrom.id}/`)}>{entity.inheritsOwnershipFrom.name}</a>
        {' '}({model.edgesTo(entity.inheritsOwnershipFrom, 'owner').map((e: any) => e.from.name ?? e.from.displayName).join(', ')}).
      </p>
    )}
    {accountability.length === 0 && !entity.inheritsOwnershipFrom && <p class="muted">Nobody is recorded as owning or supporting this.</p>}
    <table>
      <tbody>
        {
          accountability.map((e: any) => (
            <tr>
              <td class="rel-cell">
                <RelLine type={e.rel} width={28} label inverse />
              </td>
              <td>
                <EntityRef entity={e.from} />
              </td>
              <td class="muted">{e.scope ?? e.note ?? ''}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  <section class="panel block">
    <h2 class="eyebrow">Details</h2>
    <dl class="kv">
      {
        facts.map(([k, v]) => (
          <>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </>
        ))
      }
      {
        links.map(([k, v]: any) => (
          <>
            <dt>{k}</dt>
            <dd>
              <a href={v}>{v}</a>
            </dd>
          </>
        ))
      }
    </dl>
  </section>
</div>

<section class="panel block">
  <h2 class="eyebrow">{isPlatform ? `Products deployed to ${entity.name}` : `Where ${entity.name} is deployed`} <span class="n">{deployments.length}</span></h2>
  {deployments.length === 0 && <p class="muted">{isPlatform ? 'No products are deployed here.' : 'No deployment recorded.'}</p>}
  {
    deployments.length > 0 && (
      <table>
        <thead>
          <tr>
            <th>{isPlatform ? 'Product' : 'Platform'}</th>
            <th>Environments</th>
            <th>Regions</th>
            {isPlatform && <th>Owned by</th>}
          </tr>
        </thead>
        <tbody>
          {deployments.map((d: any) => {
            const other = isPlatform ? d.from : d.to;
            return (
              <tr>
                <td>
                  <EntityRef entity={other} />
                </td>
                <td>
                  <div class="chips">
                    {[].concat(d.environments ?? []).map((env: string) => (
                      <span class:list={['env', `env-${env}`]}>{env}</span>
                    ))}
                  </div>
                </td>
                <td class="muted">{list(d.regions)}</td>
                {isPlatform && (
                  <td>
                    <div class="refs">
                      {ownersOf(other).map((o: any) => (
                        <EntityRef entity={o} />
                      ))}
                    </div>
                  </td>
                )}
              </tr>
            );
          })}
        </tbody>
      </table>
    )
  }
</section>

<section class="panel block">
  <h2 class="eyebrow">{isPlatform ? `Products using ${entity.name}` : `Platforms ${entity.name} uses`} <span class="n">{usage.length}</span></h2>
  {usage.length === 0 && <p class="muted">None recorded.</p>}
  {
    usage.length > 0 && (
      <table>
        <thead>
          <tr>
            <th>{isPlatform ? 'Product' : 'Platform'}</th>
            <th>Purpose</th>
            <th>Owned by</th>
          </tr>
        </thead>
        <tbody>
          {usage.map((e: any) => {
            const other = isPlatform ? e.from : e.to;
            return (
              <tr>
                <td>
                  <EntityRef entity={other} />
                </td>
                <td class="muted">{e.purpose ?? ''}</td>
                <td>
                  <div class="refs">
                    {ownersOf(other).map((o: any) => (
                      <EntityRef entity={o} />
                    ))}
                    {ownersOf(other).length === 0 && <span class="stamp-sm">Unowned</span>}
                  </div>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    )
  }
</section>

<style>
  .crumbs {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 16px;
  }
  .head {
    display: flex;
    gap: 20px;
    align-items: center;
    padding: 20px 24px;
    border-top: 4px solid var(--navy);
    margin-bottom: 28px;
  }
  .head h1 {
    font-size: 1.75rem;
    color: var(--navy);
    margin: 2px 0 4px;
  }
  .head p {
    margin: 0;
  }
  .section-title {
    font-size: 1.1rem;
    margin-bottom: 4px;
  }
  .intro {
    margin: 0 0 12px;
    font-size: 14px;
  }
  .spacer {
    height: 28px;
  }
  .part-of {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 8px 0 0;
    font-size: 14px;
  }
  .inherit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    font-size: 14px;
    margin: 0 0 12px;
    padding: 8px 12px;
    background: var(--surface-tint);
    border-radius: var(--radius);
  }
  .kids {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 12px;
  }
  .kid {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    border: 1px solid var(--border);
    border-left: 3px solid var(--blue);
    border-radius: var(--radius);
    padding: 10px 12px;
    background: var(--surface);
  }
  .kid-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .kid-name {
    font-weight: 700;
  }
  .small {
    font-size: 12px;
  }
  .cap {
    text-transform: capitalize;
  }
  .contains {
    margin-bottom: 28px;
  }
  .built-with {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 12px;
    margin-top: 10px;
  }
  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 20px;
    margin-top: 24px;
  }
  .block {
    padding: 18px 22px;
    margin-bottom: 20px;
  }
  .block h2 {
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .n {
    background: var(--surface-tint);
    color: var(--blue);
    border-radius: 999px;
    padding: 0 8px;
    font-size: 12px;
    letter-spacing: 0;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  th {
    text-align: left;
    font-size: 12px;
    color: var(--muted);
    font-weight: 600;
    padding: 0 8px 8px 0;
    border-bottom: 1px solid var(--border);
  }
  td {
    padding: 8px 8px 8px 0;
    border-bottom: 1px solid var(--border);
    vertical-align: middle;
  }
  tr:last-child td {
    border-bottom: 0;
  }
  .rel-cell {
    width: 1%;
    white-space: nowrap;
    padding-right: 16px;
  }
  .refs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
  }
  .kv {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 8px 16px;
    margin: 0;
    font-size: 14px;
  }
  .kv dt {
    color: var(--muted);
  }
  .kv dd {
    margin: 0;
    overflow-wrap: anywhere;
    text-transform: none;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .env {
    font-size: 12px;
    font-weight: 600;
    border-radius: 3px;
    padding: 0 7px;
    background: var(--surface-tint);
    color: var(--blue);
    border: 1px solid var(--border);
  }
  .env-production,
  .env-prod {
    background: var(--navy);
    color: var(--on-navy);
    border-color: var(--navy);
  }
  .stamp-sm {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--danger);
  }
  @media (max-width: 900px) {
    .cols {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .head {
      flex-direction: column;
      align-items: flex-start;
    }
    .rel-cell :global(svg) {
      display: none;
    }
  }
</style>
