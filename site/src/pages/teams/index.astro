---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PersonChip from '../../components/PersonChip.astro';
import { atlas, href } from '../../lib/atlas';
import { headcount } from '../../../../engine/lib/model.mjs';

const { model, vocab } = atlas();
---

<Base title="Teams">
  <div class="page-header">
    <span class="eyebrow">Directory</span>
    <h1>Teams</h1>
    <p>All {model.teams.length} teams, grouped by business unit.</p>
  </div>

  {
    model.units.map((u: any) => (
      <section class="unit">
        <h2>{u.name}</h2>
        <div class="table panel" role="table" aria-label={`${u.name} teams`}>
          {u.teams.map((t: any) => {
            const hc = headcount(t);
            const type = t.type ? vocab.teamType[t.type] : null;
            return (
              <div class="row" role="row">
                <div role="cell" class="name">
                  <a href={href(`teams/${t.id}/`)}>{t.name}</a>
                  {type && (
                    <span class="muted small">
                      <Icon name={type.icon} size={12} /> {type.label}
                    </span>
                  )}
                </div>
                <div role="cell">{t.leadPerson && <PersonChip person={t.leadPerson} size="sm" />}</div>
                <div role="cell" class="hc">
                  {hc.filled} people
                  {hc.shared > 0 && <span class="pill">+{hc.shared} shared</span>}
                  {hc.open > 0 && <span class="pill pill-warn">{hc.open} open</span>}
                </div>
              </div>
            );
          })}
        </div>
      </section>
    ))
  }
</Base>

<style>
  .unit {
    margin-bottom: 28px;
  }
  .unit h2 {
    font-size: 1.1rem;
    margin-bottom: 10px;
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1.2fr) 240px;
    gap: 16px;
    align-items: center;
    padding: 12px 16px;
    border-top: 1px solid var(--border);
  }
  .row:first-child {
    border-top: 0;
  }
  .name {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .name a {
    font-weight: 700;
  }
  .small {
    font-size: 13px;
  }
  .hc {
    display: flex;
    gap: 8px;
    align-items: center;
    justify-content: flex-end;
    font-size: 14px;
    color: var(--muted);
  }
  @media (max-width: 720px) {
    .row {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .hc {
      justify-content: flex-start;
    }
  }
</style>
