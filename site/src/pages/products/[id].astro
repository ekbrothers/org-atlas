---
import Base from '../../layouts/Base.astro';
import EntityDetail from '../../components/EntityDetail.astro';
import { atlas } from '../../lib/atlas';

export function getStaticPaths() {
  return atlas().model.products.map((a: any) => ({ params: { id: a.id }, props: { id: a.id } }));
}
const entity = atlas().model.get('product', Astro.props.id);
---

<Base title={entity.name}>
  <EntityDetail entity={entity} />
</Base>
