---
import Base from '../../layouts/Base.astro';
import EntityIndex from '../../components/EntityIndex.astro';
import { atlas } from '../../lib/atlas';
const { model } = atlas();
---

<Base title="Products">
  <div class="page-header">
    <span class="eyebrow">Technology</span>
    <h1>Products</h1>
    <p>{model.products.length} products and solutions, the teams that own them and the platforms they run on.</p>
  </div>
  <EntityIndex kind="product" />
</Base>
